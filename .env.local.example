# Authentication Credentials
# Default admin credentials for Matrix Hub Admin Console.
# These are intentionally weak — change them for any real deployment.
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@matrixhub.io

# ---------------------------------------------------------------------------
# Matrix Hub backend
# ---------------------------------------------------------------------------
#
# Production default (used when both env vars below are unset):
#   https://api.matrixhub.io
#
# Override for local development against a self-hosted Hub:
#   HUB_URL=http://localhost:8000
#
# HUB_URL is server-only and preferred. NEXT_PUBLIC_HUB_URL is read as
# a fallback so existing deployments that set the public variant keep
# working without re-configuration.

HUB_URL=https://api.matrixhub.io
# NEXT_PUBLIC_HUB_URL=https://api.matrixhub.io

# OPTIONAL: bearer token for write-side endpoints on private Hub deployments.
# Most catalog endpoints on api.matrixhub.io are public; only set this if
# you target a Hub that requires authentication.
# HUB_API_TOKEN=your_token_here

# ---------------------------------------------------------------------------
# MCP Gateway (legacy, optional)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GW_URL=https://your-gateway-api.com
# NEXT_PUBLIC_GW_TOKEN=your_token_here
