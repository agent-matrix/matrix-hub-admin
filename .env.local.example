# Authentication Credentials
# Default admin credentials for Matrix Hub Admin Console.
# These are intentionally weak — change them for any real deployment.
NEXT_PUBLIC_ADMIN_USERNAME=admin
NEXT_PUBLIC_ADMIN_PASSWORD=admin
NEXT_PUBLIC_ADMIN_EMAIL=admin@matrixhub.io

# ---------------------------------------------------------------------------
# Matrix Hub backend
# ---------------------------------------------------------------------------
#
# Production default (used when both env vars below are unset):
#   https://api.matrixhub.io
#
# Override for local development against a self-hosted Hub:
#   HUB_URL=http://localhost:8000
#
# HUB_URL is server-only and preferred. NEXT_PUBLIC_HUB_URL is read as
# a fallback so existing deployments that set the public variant keep
# working without re-configuration.

HUB_URL=https://api.matrixhub.io
# NEXT_PUBLIC_HUB_URL=https://api.matrixhub.io

# OPTIONAL: bearer token for write-side endpoints on private Hub deployments.
# Most catalog endpoints on api.matrixhub.io are public; only set this if
# you target a Hub that requires authentication.
# HUB_API_TOKEN=your_token_here

# ---------------------------------------------------------------------------
# MCP Gateway (legacy, optional)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_GW_URL=https://your-gateway-api.com
# NEXT_PUBLIC_GW_TOKEN=your_token_here

# ---------------------------------------------------------------------------
# User management — Postgres (Neon) + email verification (Resend)
# ---------------------------------------------------------------------------
# Neon pooled connection string. Required for DB-backed users/login.
# Run `npm run db:migrate` once to create the tables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Secret used to sign session JWTs. Use a long random string:
#   openssl rand -base64 48
AUTH_SECRET=change_me_to_a_long_random_string

# Public base URL of this admin app (used in verification email links).
APP_URL=http://localhost:3000

# Resend (https://resend.com) — transactional email for verification/invites.
# When unset, emails are skipped and the link is logged to the server console.
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender. Use your domain once verified, e.g. "MatrixHub <noreply@matrixhub.io>".
RESEND_FROM=MatrixHub <onboarding@resend.dev>

# On-prem ROOT admin.
# This is an on-prem, single-root deployment: public signup is disabled. The
# FIRST run (zero users) lets you create the one root admin via the web setup
# screen — after that the signup UI never appears again. Alternatively seed it
# headlessly with the vars below and `npm run db:seed-admin`. Afterwards, the
# root admin creates all other users from the Users page (each must verify email).
# ADMIN_EMAIL=root@matrixhub.io
# ADMIN_PASSWORD=change_me_min_8_chars
# ADMIN_NAME=Root Administrator
# ADMIN_TENANT=MatrixHub
